# ==============================================================================
# ENVIRONMENT VARIABLES - INNOVA CABS BANGALORE
# ==============================================================================
# Sourced from PROJECT_CONTEXT.md.
# Copy this file to .env.local and fill in the corresponding production credentials.
# Do not commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public - Read-Only)
# ------------------------------------------------------------------------------
# Also powers customer accounts (booking Step 4 "Sign in & Confirm"). In the
# Firebase console: Authentication -> Get started, enable the "Google" and
# "Email/Password" providers, and add your live domain under
# Authentication -> Settings -> Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyPlaceholder"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="innova-cabs-bangalore.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="innova-cabs-bangalore"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="innova-cabs-bangalore.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
# Admin phone/desktop alerts for new bookings and sign-ups (web push).
# Firebase console -> Project settings -> Cloud Messaging -> Web Push
# certificates -> "Generate key pair", then paste the key here.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Server-Only - Privileged Operations)
# ------------------------------------------------------------------------------
# Service Account credentials for Server Actions & API routes
FIREBASE_PROJECT_ID="innova-cabs-bangalore"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@innova-cabs-bangalore.iam.gserviceaccount.com"
# Note: Keep the newline characters escaped as \n if entered as a single-line string
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Google Places API (Location Autocomplete & Address Resolution)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY="AIzaSyYourGooglePlacesApiKeyPlaceholder"
GOOGLE_PLACES_API_KEY="AIzaSyYourGooglePlacesApiKeyPlaceholder"

# ------------------------------------------------------------------------------
# 4. Resend (Transactional Email Notifications for Bookings)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
ADMIN_EMAIL="greensrentacab@gmail.com"
# Customer booking receipts go to any address only from a verified domain;
# with onboarding@resend.dev Resend delivers only to your own account email.
NOTIFICATION_EMAIL_FROM="Innova Cabs Bangalore <bookings@yourverifieddomain.com>"

# ------------------------------------------------------------------------------
# 5. Admin Console (REQUIRED in production)
# ------------------------------------------------------------------------------
# Password for /admin/login. In production there is no default — login is
# disabled until this is set. Use a long, unique password.
ADMIN_PASSWORD="change-me-to-a-long-random-password"
# Optional: separate secret for signing the admin session cookie
# (defaults to ADMIN_PASSWORD). Changing it signs everyone out.
ADMIN_SESSION_SECRET="another-long-random-string"

# ------------------------------------------------------------------------------
# 6. Site & Business Metadata
# ------------------------------------------------------------------------------
# Your live domain, e.g. https://www.innovacabsbangalore.com (used for share previews)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_PHONE="9686025999"

# ------------------------------------------------------------------------------
# 7. Client Reveal Gate (optional -- off by default)
# ------------------------------------------------------------------------------
# Leave unset (or "*") to keep the whole site public -- this is the default.
# To hide pages again later, set this to a comma-separated list of the paths
# that SHOULD stay public; everything else shows a branded "Coming Soon" page
# instead (see middleware.ts). "/" is the homepage. A trailing "/*" releases
# a path and everything nested under it.
# Example: "/,/about,/contact,/routes/*"
# Update this in Netlify/Vercel (Site/Project Settings -> Environment
# Variables) and redeploy to change what's visible -- no code push needed.
RELEASED_ROUTES="*"

# ------------------------------------------------------------------------------
# 8. Cloudinary (Admin -> Homepage images uploads)
# ------------------------------------------------------------------------------
# Free account at cloudinary.com -> Dashboard ("Product environment
# credentials"). Uploads go straight from the admin's browser to Cloudinary
# (signed by the server; the secret never reaches the browser) into the folder
# innova-cabs/site-images. Without these, the admin can still reorder/reset
# pictures but uploads are switched off and the built-in pictures are shown.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternatively one variable: CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
